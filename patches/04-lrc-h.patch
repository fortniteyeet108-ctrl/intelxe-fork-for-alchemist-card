 static const uint8_t xe2_bcs_offsets[] = {
 	LRC_NOP(1),
 	LRC_LRI(15, LRC_POSTED),
@@ -130,3 +173,13 @@ static inline void lrcSetOffsets(uint32_t *regs, const uint8_t *data, uint32_t b
 	}
 	*regs = MI_BATCH_BUFFER_END | 1;
 }
+
+// Matches Linux drivers/gpu/drm/xe/xe_lrc.c reg_offsets() (and xe_probe.cpp):
+// XE_ENGINE_CLASS_COPY (drmClass == 1) uses gen12_xcs_offsets on all < 20.00 (including DG2 12.55);
+// CCS/VCS/VECS use dg2_xcs_offsets on >= 12.55 and gen12_xcs_offsets below 12.55.
+static inline const uint8_t *lrcRegOffsets(uint16_t graphicsVerx100, uint16_t drmClass) {
+	if (drmClass == 0) return graphicsVerx100 >= 2000 ? xe2_rcs_offsets : dg2_rcs_offsets;
+	if (drmClass == 1) return graphicsVerx100 >= 2000 ? xe2_bcs_offsets : gen12_xcs_offsets;
+	if (graphicsVerx100 >= 2000) return xe2_xcs_offsets;
+	return graphicsVerx100 >= 1255 ? dg2_xcs_offsets : gen12_xcs_offsets;
+}
